# Copy this file to .env and fill in your own key.
# The backend reads these from the nearest .env (this folder or a parent).

# Your Portkey API key (keep secret — never commit the real value).
PORTKEY_API_KEY=your-portkey-api-key-here

# Model served through Portkey's OpenAI-compatible gateway.
MODEL_NAME=gpt-5.6-luna

# Portkey gateway base URL (leave as-is unless you use a different gateway).
PORTKEY_BASE_URL=https://api.portkey.ai/v1
